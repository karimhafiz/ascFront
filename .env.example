# Copy to .env and fill in real values. Never commit the real .env file.
# All Vite env vars used by the app must be prefixed VITE_ to be exposed to client code.

# Backend API base URL — include trailing slash (used as `${API}courses`, etc.)
VITE_DEV_URI=http://localhost:5000/

# Google OAuth client ID — same project/client as the backend's GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=

# EmailJS (Contact page — src/pages/content/Contact.jsx)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
